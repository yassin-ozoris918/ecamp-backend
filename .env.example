# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:0000@localhost:5432/lms_db"

# JWT Secrets (use `openssl rand -base64 32` to generate)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Google Gemini API Key (for AI question extraction)
GEMINI_API_KEY=

# Cloudflare R2 (S3-compatible) Storage
# Leave all R2_* variables empty to use local file system storage instead.
# Local files are saved under uploads/ and served at /uploads/ path.
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_lms_bucket_name
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
FRONTEND_URL=http://localhost:5173

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Server
PORT=3000

# Amaan Stream
AMAAN_API_KEY=
